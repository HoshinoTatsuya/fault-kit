{
  "name": "@hoshinotatsuya/fault-kit",
  "version": "0.3.3",
  "description": "Fault injection for specs: a freezing TCP proxy, a silent and slow DNS server, Postgres horizon/writer/lock holders, Redis pause and client kills, a shell wrapper without exec with orphan detection, and deadline assertions without wall clocks.",
  "keywords": [
    "fault-injection",
    "testing",
    "chaos",
    "tcp-proxy",
    "dns",
    "postgres",
    "redis",
    "jest",
    "orphan-processes",
    "network-partition"
  ],
  "license": "MIT",
  "author": "Hoshino_Tatsuya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HoshinoTatsuya/fault-kit.git"
  },
  "homepage": "https://github.com/HoshinoTatsuya/fault-kit#readme",
  "bugs": {
    "url": "https://github.com/HoshinoTatsuya/fault-kit/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tcp": {
      "types": "./dist/tcp/index.d.ts",
      "default": "./dist/tcp/index.js"
    },
    "./dns": {
      "types": "./dist/dns/index.d.ts",
      "default": "./dist/dns/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "default": "./dist/postgres/index.js"
    },
    "./redis": {
      "types": "./dist/redis/index.d.ts",
      "default": "./dist/redis/index.js"
    },
    "./process": {
      "types": "./dist/process/index.d.ts",
      "default": "./dist/process/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "tcp": [
        "./dist/tcp/index.d.ts"
      ],
      "dns": [
        "./dist/dns/index.d.ts"
      ],
      "postgres": [
        "./dist/postgres/index.d.ts"
      ],
      "redis": [
        "./dist/redis/index.d.ts"
      ],
      "process": [
        "./dist/process/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.ru.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.4.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.examples.json && node scripts/check-readme-examples.mjs",
    "lint": "biome check src",
    "test": "scripts/with-postgres.sh scripts/with-redis.sh jest-groups --out .jest-report.json -- node_modules/.bin/jest && jest-assert-no-skipped .jest-report.json",
    "test:consumers": "scripts/consumer-matrix.sh",
    "test:docker": "pnpm run build && jest-groups --out .jest-report-docker.json -- node_modules/.bin/jest -c jest.docker.config.js && jest-assert-no-skipped .jest-report-docker.json",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run test:process && pnpm run test:docker && pnpm run test:consumers && pnpm run build",
    "test:process": "scripts/in-linux-container.sh node_modules/.bin/jest-groups --out .jest-report-process.json -- node_modules/.bin/jest -c jest.process.config.js && jest-assert-no-skipped .jest-report-process.json",
    "test:examples": "scripts/with-postgres.sh scripts/with-redis.sh scripts/run-examples.sh",
    "test:examples:process": "scripts/in-linux-container.sh node_modules/.bin/jest-groups --out .jest-report-examples-process.json -- node_modules/.bin/jest -c jest.examples.config.js --testPathPatterns examples/process && jest-assert-no-skipped .jest-report-examples-process.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@types/pg": ">=8.15.0",
    "pg": "^8.11.0"
  },
  "peerDependenciesMeta": {
    "@types/pg": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@hoshinotatsuya/arch-gates": "^0.12.2",
    "@hoshinotatsuya/jest-groups": "^0.7.2",
    "@types/jest": "30.0.0",
    "@types/node": "24.0.15",
    "@types/pg": "8.23.1",
    "ioredis": "5.8.2",
    "jest": "30.5.2",
    "pg": "8.18.0",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.5",
    "typescript": "5.9.3"
  }
}
